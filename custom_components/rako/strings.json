                    "host": "[%key:common::config_flow::data::host%]",
                    "port": "[%key:common::config_flow::data::port%]",
                    "name": "[%key:common::config_flow::data::name%]",
                    "mac": "MAC Address"
                }
            },
            "reconfigure": {
                "title": "Rako Bridge Configuration",
                "description": "Update where the bridge can be reached. Its MAC address identifies the bridge and cannot be changed here.",
                "data": {
                    "host": "[%key:common::config_flow::data::host%]",
                    "port": "[%key:common::config_flow::data::port%]"
                }
            }
        }
    },
    "options": {
        "step": {
            "init": {
                "title": "Rako options",
                "description": "State arrives as broadcasts from the bridge; the poll is a safety net that bounds how long a missed broadcast can leave a light showing the wrong state.",
                "data": {
                    "poll_interval": "Reconciliation poll interval",
                    "transport": "Command transport",
                    "min_command_interval": "Minimum interval between commands"
                },
                "data_description": {
                    "poll_interval": "How often to re-read the bridge's scene cache, in seconds. Minimum 60.",
                    "transport": "How commands are sent to the bridge. Status is always received over UDP.",
                    "min_command_interval": "The bridge silently drops commands sent too close together. Measured safe minimum is 1 second; the default leaves a margin."
                }
            }
        }
    },
